BASE: ['base.yaml']

MODEL:
  TYPE: pvmamba
  NAME: tiny_tinyimagenet
  NUM_CLASSES: 200
  DROP_PATH_RATE: 0.2
  PVMAMBA:
    IMAGE_SIZE: 224
    EMBED_DIM: 64
    DEPTHS: [2, 4, 8, 4]
    NUM_HEADS: [2, 4, 8, 16]
    SSD_EXPANSION: 2
    SSD_CHUNK_SIZE: 256
    TOKEN_MIXER_TYPES: ['LoDSA', 'LoDSA', 'SaDSA', 'attention']
    SPATIAL_FLAG: [[], [], [0, 2, 2, 1, 2, 2, 1, 2], [0, 2, 2, 1]]

  DDP: 'torch'

DATA:
  DATASET: 'imagenet'
  DATA_PATH: '/home/jlx_75/datasets/tiny-imagenet/tiny-imagenet-200'
  IMG_SIZE: 224
  BATCH_SIZE: 64
  NUM_WORKERS: 8
  PIN_MEMORY: True

TRAIN:
  EPOCHS: 1
  WARMUP_EPOCHS: 0
  BASE_LR: 5e-4
  WARMUP_LR: 5e-7
  MIN_LR: 5e-6
  WEIGHT_DECAY: 0.05
  AUTO_RESUME: False
  MESA: 1.0

AUG:
  MIXUP: 0.8
  CUTMIX: 1.0
  AUTO_AUGMENT: rand-m9-mstd0.5-inc1
  REPROB: 0.25

TEST:
  CROP: True